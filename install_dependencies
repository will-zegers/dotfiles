#! /usr/bin/env bash

set -e

DOTFILES_DIR="$( cd "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"

INSTALL_ALACRITTY=true
while [[ "$#" -gt 0 ]]; do
  case $1 in
    --no-alacritty)
      INSTALL_ALACRITTY=false
      ;;
    *)
      echo "Unknown argument: '$1'";
      exit 1
  esac
  shift
done

PACKAGES="
  bat
  curl
  gcc
  git
  ripgrep
  sudo
  tmux
  tree
  wget
  xclip
  zsh
"

if command -v apt; then
  apt update -y
  apt install -y ${PACKAGES}
elif command -v pacman; then
  pacman -Sy
  pacman -S --noconfirm ${PACKAGES}
else
  source /etc/os-release
  echo "Unsupported Linux distro: ${NAME}"
  exit 1
fi

# Nodejs v22+ needed for Copilot plugin and Gemini CLI
curl -fsSL https://deb.nodesource.com/setup_25.x | sudo bash -
apt install -y nodejs

npm install -g @google/gemini-cli

${DOTFILES_DIR}/nvim/install

if ! command -v alacritty && ${INSTALL_ALACRITTY}; then
  ${DOTFILES_DIR}/alacritty/install ${DOTFILES_DIR}
fi

touch /tmp/install_dependencies.stamp
